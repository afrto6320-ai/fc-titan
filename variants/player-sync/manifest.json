{
  "manifest_version": 3,
  "name": "CODEX SNIPE | FC Web App Embedded",
  "short_name": "CODEX SNIPE",
  "version": "3.17.1",
  "description": "Optional Min Bid, regular Max Bid or smart Max Bid above the native Buy Now cap; Enhancer native market search.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.ea.com/*",
    "https://www.fut.gg/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "CODEX SNIPE",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "js": [
        "bid-ladder.js",
        "runtime-main.js"
      ]
    },
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "run_at": "document_idle",
      "js": [
        "snipe-core.js",
        "native-market.js",
        "runtime-client.js",
        "embedded.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "embedded.css"
      ],
      "matches": [
        "https://www.ea.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
